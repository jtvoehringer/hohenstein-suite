# ─────────────────────────────────────────────────────────────────────────────
# Hohenstein Suite – Umgebungsvariablen
# Kopie als .env.local anlegen (wird nicht committet) bzw. in Vercel eintragen.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase (Projekt hohenstein-suite, Supabase Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://usvniwfqozqkxdhjjumm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service Role Key – nur serverseitig (Benutzer einladen, Cron)
SUPABASE_SERVICE_ROLE_KEY=

# Öffentliche App-URL (Einladungs-/Reset-Links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Schlüssel zur Verschlüsselung der IMAP-/SMTP-Passwörter (beliebiger langer Zufallsstring)
EMAIL_CRYPT_SECRET=

# Schutz der Cron-Route /api/cron/ea-dauerauftraege (Vercel setzt CRON_SECRET automatisch als Header)
CRON_SECRET=

# Optional: Beleg-Erkennung (OCR) über Claude – ohne Schlüssel werden Belege ohne Erkennung gespeichert
ANTHROPIC_API_KEY=
