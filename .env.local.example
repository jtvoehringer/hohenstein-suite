# ─────────────────────────────────────────────────────────────────────────────
# Hohenstein Suite – Umgebungsvariablen
# Kopie als .env.local anlegen (wird nicht committet) bzw. in Vercel eintragen.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase (Projekt hohenstein-suite, Supabase Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://usvniwfqozqkxdhjjumm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service Role Key – nur serverseitig (Benutzer einladen, Cron)
SUPABASE_SERVICE_ROLE_KEY=

# Öffentliche App-URL (Einladungs-/Reset-Links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Schlüssel zur Verschlüsselung der IMAP-/SMTP-Passwörter (beliebiger langer Zufallsstring)
EMAIL_CRYPT_SECRET=

# Schutz der Cron-Route /api/cron/ea-dauerauftraege (Vercel setzt CRON_SECRET automatisch als Header)
CRON_SECRET=

# Optional: Beleg-Erkennung (OCR) über Claude – ohne Schlüssel werden Belege ohne Erkennung gespeichert
ANTHROPIC_API_KEY=

# software:112-Anbindung (Demo-Umgebung: Reset + Demo-Zugänge) – Werte aus dem software:112-Projekt
S112_SUPABASE_URL=https://zwcsgnemijkpyxrqykul.supabase.co
S112_SERVICE_ROLE_KEY=
S112_APP_URL=https://software112.icp-consultants.at
S112_DEMO_TENANT_ID=33333333-3333-4333-8333-333333333333

# ── Trialzugang über hohenstein-partner.at (Migration 014, /api/public/trial) ──
# Erlaubte Herkunft(en) für CORS, kommagetrennt
TRIAL_ALLOWED_ORIGINS=https://hohenstein-partner.at,https://www.hohenstein-partner.at
# Gültigkeitsdauer eines automatisch vergebenen Trialzugangs in Tagen
TRIAL_DAUER_TAGE=14
# Interne Benachrichtigung bei neuer Trialanfrage, kommagetrennt (leer = keine Mail)
TRIAL_INTERN_BENACHRICHTIGUNG=jv@hohenstein-partner.at,jg@hohenstein-partner.at,pd@hohenstein-partner.at

# Transaktionaler Mailversand (Trial-Zugangsdaten, interne Benachrichtigung) über Brevo-SMTP
# Brevo → SMTP & API → SMTP-Zugangsdaten; Absenderadresse muss in Brevo verifiziert sein.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASS=
BREVO_SENDER_EMAIL=office@hohenstein-partner.at
BREVO_SENDER_NAME=Hohenstein Consulting
